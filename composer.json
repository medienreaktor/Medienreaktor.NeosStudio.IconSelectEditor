{
  "name": "medienreaktor/neos-studio-icon-select-editor",
  "type": "neos-plugin",
  "description": "The icon select editor for Neos Studio: pick an SVG icon from one or more configured icon folders. Drop-in replacement for the classic-UI Medienreaktor.IconSelectEditor - same editor id, same data source, same stored value.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "neos",
    "neoscms",
    "flow",
    "editor",
    "icon",
    "neos-studio"
  ],
  "require": {
    "php": "^8.2",
    "neos/neos": "^9.1",
    "medienreaktor/neos-studio": "^1.19.1",
    "beromir/neos-icon-select-editor": "^1.1"
  },
  "require-dev": {
    "neos/contentgraph-doctrinedbaladapter": "^9.1"
  },
  "extra": {
    "neos": {
      "package-key": "Medienreaktor.NeosStudio.IconSelectEditor"
    },
    "branch-alias": {
      "dev-main": "1.1.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "neos/composer-plugin": true
    }
  },
  "scripts": {
    "lint:composer": "@composer validate --strict --no-check-lock",
    "lint": [
      "@lint:composer"
    ]
  }
}
